ss=\"mf-sg__overlay\" aria-hidden=\"true\">\n    <div\n      id=\"mf-sg-modal\"\n      class=\"mf-sg__modal\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"mf-sg-title\"\n    >\n      <button\n        type=\"button\"\n        class=\"mf-sg__close\"\n        aria-label=\"Fermer le guide des tailles\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n          <path d=\"M5 5l14 14M19 5L5 19\" />\n        </svg>\n      </button>\n\n      <div class=\"mf-sg__header\">\n        <h2 id=\"mf-sg-title\" class=\"mf-sg__heading\">Guide des Tailles</h2>\n        <p class=\"mf-sg__subheading\">Culotte Post-Partum Compression 360°</p>\n      </div>\n\n      <div class=\"mf-sg__body\">\n        <div class=\"mf-sg__table-wrap\">\n          <table class=\"mf-sg__table\">\n            <thead>\n              <tr>\n                <th scope=\"col\">Belayan</th>\n                <th scope=\"col\">Tour de taille</th>\n                <th scope=\"col\">Taille FR</th>\n              </tr>\n            </thead>\n\n            <tbody>\n              <tr>\n                <td>S</td>\n                <td>62 – 68 cm</td>\n                <td>34 – 36</td>\n              </tr>\n\n              <tr>\n                <td>M</td>\n                <td>68 – 76 cm</td>\n                <td>38 – 40</td>\n              </tr>\n\n              <tr>\n                <td>L</td>\n                <td>76 – 82 cm</td>\n                <td>40 – 42</td>\n              </tr>\n\n              <tr>\n                <td>XL</td>\n                <td>82 – 90 cm</td>\n                <td>44 – 46</td>\n              </tr>\n\n              <tr>\n                <td>2XL</td>\n                <td>88 – 100 cm</td>\n                <td>48 – 50</td>\n              </tr>\n\n              <tr>\n                <td>3XL</td>\n                <td>92 – 112 cm</td>\n                <td>50 – 52+</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n\n        <div class=\"mf-sg__tip\">\n          <span class=\"mf-sg__tip-icon\" aria-hidden=\"true\">💡</span>\n          <p>\n            Entre deux tailles ? Prenez la plus petite pour un\n            <strong>maintien optimal</strong>. Notre tissu mesh épouse votre\n            corps en douceur.\n          </p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n  (function () {\n    var script = document.currentScript;\n    var wrapper = script.previousElementSibling;\n\n    if (!wrapper) return;\n\n    var button = wrapper.querySelector('.mf-sg__button');\n    var overlay = wrapper.querySelector('.mf-sg__overlay');\n    var closeButton = wrapper.querySelector('.mf-sg__close');\n\n    function openModal() {\n      overlay.classList.add('is-open');\n      overlay.setAttribute('aria-hidden', 'false');\n      document.body.classList.add('mf-sg-lock');\n      closeButton.focus();\n    }\n\n    function closeModal() {\n      overlay.classList.remove('is-open');\n      overlay.setAttribute('aria-hidden', 'true');\n      document.body.classList.remove('mf-sg-lock');\n      button.focus();\n    }\n\n    button.addEventListener('click', openModal);\n    closeButton.addEventListener('click', closeModal);\n\n    overlay.addEventListener('click', function (event) {\n      if (event.target === overlay) {\n        closeModal();\n      }\n    });\n\n    document.addEventListener('keydown', function (event) {\n      if (event.key === 'Escape' && overlay.classList.contains('is-open')) {\n        closeModal();\n      }\n    });\n  })();\n</script>"
