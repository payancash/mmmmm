parison__card--product h3 {\n    color: #171717;\n  }\n\n  .mi-forma-comparison__card h3 span {\n    flex-shrink: 0;\n    font-size: 24px;\n    line-height: 1;\n  }\n\n  .mi-forma-comparison__card ul {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .mi-forma-comparison__card li {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    margin-bottom: 16px;\n    color: #565656;\n    font-size: 15px;\n    font-weight: 400;\n    line-height: 1.45;\n  }\n\n  .mi-forma-comparison__card li:last-child {\n    margin-bottom: 0;\n  }\n\n  .mi-forma-comparison__card li span {\n    flex-shrink: 0;\n    margin-top: 1px;\n    font-size: 20px;\n    font-weight: 600;\n    line-height: 1.2;\n  }\n\n  .mi-forma-comparison__card--classic li span {\n    color: #c6c6c6;\n  }\n\n  .mi-forma-comparison__card--product li span {\n    color: #111111;\n  }\n\n  .mi-forma-comparison__note {\n    width: 100%;\n    margin-top: 16px;\n    padding: 15px 18px;\n    box-sizing: border-box;\n    background: #B3437A;\n    border-radius: 12px;\n    color: #ffffff;\n  }\n\n  .mi-forma-comparison__note p {\n    margin: 0;\n    color: #ffffff;\n    font-size: 12px;\n    font-weight: 500;\n    line-height: 1.5;\n  }\n\n  .mi-forma-comparison__note strong {\n    color: #ffffff;\n    font-weight: 800;\n  }\n\n  @media screen and (max-width: 749px) {\n    .mi-forma-comparison {\n      padding: 16px 14px;\n    }\n\n    .mi-forma-comparison__eyebrow {\n      margin-bottom: 12px;\n      font-size: 11px;\n    }\n\n    .mi-forma-comparison__title {\n      font-size: 24px;\n    }\n\n    .mi-forma-comparison__subtitle {\n      margin-top: 14px;\n      font-size: 16px;\n    }\n\n    .mi-forma-comparison__image {\n      border-radius: 12px;\n    }\n\n    .mi-forma-comparison__card {\n      padding: 20px 16px;\n      border-radius: 15px;\n    }\n\n    .mi-forma-comparison__card h3 {\n      margin-bottom: 17px;\n      font-size: 15px;\n    }\n\n    .mi-forma-comparison__card h3 span {\n 