parison__card--product h3 {\n    color: #171717;\n  }\n\n  .mi-forma-comparison__card h3 span {\n    flex-shrink: 0;\n    font-size: 24px;\n    line-height: 1;\n  }\n\n  .mi-forma-comparison__card ul {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .mi-forma-comparison__card li {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    margin-bottom: 16px;\n    color: #565656;\n    font-size: 15px;\n    font-weight: 400;\n    line-height: 1.45;\n  }\n\n  .mi-forma-comparison__card li:last-child {\n    margin-bottom: 0;\n  }\n\n  .mi-forma-comparison__card li span {\n    flex-shrink: 0;\n    margin-top: 1px;\n    font-size: 20px;\n    font-weight: 600;\n    line-height: 1.2;\n  }\n\n  .mi-forma-comparison__card--classic li span {\n    color: #c6c6c6;\n  }\n\n  .mi-forma-comparison__card--product li span {\n    color: #111111;\n  }\n\n  .mi-forma-comparison__note {\n    width: 100%;\n    margin-top: 16px;\n    padding: 15px 18px;\n    box-sizing: border-box;\n    background: #B3437A;\n    border-radius: 12px;\n    color: #ffffff;\n  }\n\n  .mi-forma-comparison__note p {\n    margin: 0;\n    color: #ffffff;\n    font-size: 12px;\n    font-weight: 500;\n    line-height: 1.5;\n  }\n\n  .mi-forma-comparison__note strong {\n    color: #ffffff;\n    font-weight: 800;\n  }\n\n  @media screen and (max-width: 749px) {\n    .mi-forma-comparison {\n      padding: 16px 14px;\n    }\n\n    .mi-forma-comparison__eyebrow {\n      margin-bottom: 12px;\n      font-size: 11px;\n    }\n\n    .mi-forma-comparison__title {\n      font-size: 24px;\n    }\n\n    .mi-forma-comparison__subtitle {\n      margin-top: 14px;\n      font-size: 16px;\n    }\n\n    .mi-forma-comparison__image {\n      border-radius: 12px;\n    }\n\n    .mi-forma-comparison__card {\n      padding: 20px 16px;\n      border-radius: 15px;\n    }\n\n    .mi-forma-comparison__card h3 {\n      margin-bottom: 17px;\n      font-size: 15px;\n    }\n\n    .mi-forma-comparison__card h3 span {\n      font-size: 22px;\n    }\n\n    .mi-forma-comparison__card li {\n      gap: 9px;\n      margin-bottom: 15px;\n      font-size: 14px;\n    }\n\n    .mi-forma-comparison__card li span {\n      font-size: 19px;\n    }\n\n    .mi-forma-comparison__note {\n      padding: 14px 16px;\n    }\n\n    .mi-forma-comparison__note p {\n      font-size: 11px;\n    }\n  }\n</style>\n\n<section class=\"mi-forma-comparison\">\n\n  <div class=\"mi-forma-comparison__header\">\n    <div class=\"mi-forma-comparison__eyebrow\">\n      POR QUÉ ES DIFERENTE\n    </div>\n\n    <h2 class=\"mi-forma-comparison__title\">\n      Las demás solo comprimen la parte delantera.<br>\n      Mi Forma envuelve todo el contorno.\n    </h2>\n\n    <p class=\"mi-forma-comparison__subtitle\">\n      Como lo hace el bengkung malayo desde hace 500 años.\n    </p>\n  </div>\n\n  <div class=\"mi-forma-comparison__image\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0941/3764/7370/files/hf_20260625_151841_f778b39f-6da7-4b0a-9dce-5c0ba5cfba9c.webp?v=1785859146\"\n      alt=\"Comparación entre una faja clásica y Mi Forma\"\n      loading=\"lazy\"\n    >\n  </div>\n\n  <div class=\"mi-forma-comparison__cards\">\n\n    <div class=\"mi-forma-comparison__card mi-forma-comparison__card--classic\">\n      <h3>\n        <span>✕</span>\n        FAJA CLÁSICA\n      </h3>\n\n      <ul>\n        <li>\n          <span>✕</span>\n          <div>Solo comprime la parte delantera del abdomen</div>\n        </li>\n\n        <li>\n          <span>✕</span>\n          <div>Se sube y se desliza al cabo de una hora</div>\n        </li>\n\n        <li>\n          <span>✕</span>\n          <div>Se nota debajo de la ropa</div>\n        </li>\n\n        <li>\n          <span>✕</span>\n          <div>Ningún resultado duradero: todo vuelve a caer</div>\n        </li>\n      </ul>\n    </div>\n\n    <div class=\"mi-forma-comparison__card mi-forma-comparison__card--product\">\n      <h3>\n        <span>✓</span>\n        MI FORMA\n      </h3>\n\n      <ul>\n        <li>\n          <span>✓</span>\n          <div>Compresión 360°: delante, laterales y espalda</div>\n        </li>\n\n        <li>\n          <span>✓</span>\n          <div>Se pone en 10 segundos como una prenda interior</div>\n        </li>\n\n        <li>\n          <span>✓</span>\n          <div>Desaparece debajo de toda tu ropa</div>\n        </li>\n\n        <li>\n          <span>✓</span>\n          <div>Diferencia visible desde la segunda o tercera semana</div>\n        </li>\n      </ul>\n    </div>\n\n  </div>\n\n  <div class=\"mi-forma-comparison__note\">\n    <p>\n      <strong>Inspirada en el bengkung malayo:</strong>\n      una técnica de compresión cruzada utilizada desde hace 500 años\n      para reafirmar la zona abdominal después del parto.\n    </p>\n  </div>\n\n</section>",
