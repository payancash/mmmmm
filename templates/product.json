  margin: 8px 0 22px;\n    text-align: center;\n    color: #B3437A;\n    font-size: 14px;\n    font-weight: 600;\n    line-height: 1.4;\n  }\n\n  .mf-size-guide__table-wrap {\n    width: 100%;\n    overflow-x: auto;\n    border: 1px solid #ead8e1;\n    border-radius: 12px;\n  }\n\n  .mf-size-guide__table {\n    width: 100%;\n    min-width: 620px;\n    border-collapse: collapse;\n    color: #2d2d2d;\n    font-size: 13px;\n  }\n\n  .mf-size-guide__table th {\n    padding: 13px 10px;\n    background: #B3437A;\n    color: #ffffff;\n    font-size: 12px;\n    font-weight: 800;\n    text-align: center;\n    text-transform: uppercase;\n  }\n\n  .mf-size-guide__table td {\n    padding: 13px 10px;\n    border-bottom: 1px solid #efdee6;\n    text-align: center;\n    background: #ffffff;\n  }\n\n  .mf-size-guide__table tr:nth-child(even) td {\n    background: #fbf2f6;\n  }\n\n  .mf-size-guide__table tr:last-child td {\n    border-bottom: 0;\n  }\n\n  .mf-size-guide__table td:first-child {\n    font-weight: 800;\n    color: #B3437A;\n  }\n\n  .mf-size-guide__steps {\n    margin-top: 20px;\n    padding: 16px 18px;\n    background: #fbf2f6;\n    border: 1px solid #ead8e1;\n    border-radius: 12px;\n  }\n\n  .mf-size-guide__steps p {\n    margin: 0 0 9px;\n    color: #4f4f4f;\n    font-size: 13px;\n    line-height: 1.55;\n  }\n\n  .mf-size-guide__steps p:last-child {\n    margin-bottom: 0;\n  }\n\n  .mf-size-guide__steps strong {\n    color: #B3437A;\n  }\n\n  .mf-size-guide__tip {\n    margin-top: 14px;\n    color: #666666;\n    font-size: 12px;\n    line-height: 1.55;\n    text-align: center;\n  }\n\n  body.mf-size-guide-lock {\n    overflow: hidden;\n  }\n\n  @media screen and (max-width: 749px) {\n    .mf-size-guide__button {\n      padding: 14px 29px;\n      font-size: 15px;\n    }\n\n    .mf-size-guide__overlay {\n      padding: 12px;\n    }\n\n    .mf-size-guide__modal {\n      max-height: 90vh;\n      padding: 25px 16px 20px;\n      border-radius: 16px;\n    }\n\n    .mf-size-guide__heading {\n      font-size: 21px;\n    }\n\n    .mf-size-guide__subheading {\n      margin-bottom: 18px;\n      font-size: 13px;\n    }\n\n    .mf-size-guide__table {\n      font-size: 12px;\n    }\n\n    .mf-size-guide__table th,\n    .mf-size-guide__table td {\n      padding: 11px 8px;\n    }\n  }\n</style>\n\n<div class=\"mf-size-guide\">\n  <div class=\"mf-size-guide__button-wrap\">\n    <button\n      type=\"button\"\n      class=\"mf-size-guide__button\"\n      aria-haspopup=\"dialog\"\n      aria-controls=\"mf-size-guide-modal\"\n    >\n      Guía de tallas ›\n    </button>\n  </div>\n\n  <div class=\"mf-size-guide__overlay\" aria-hidden=\"true\">\n    <div\n      id=\"mf-size-guide-modal\"\n      class=\"mf-size-guide__modal\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"mf-size-guide-title\"\n    >\n      <button\n        type=\"button\"\n        class=\"mf-size-guide__close\"\n        aria-label=\"Cerrar la guía de tallas\"\n      >\n        ×\n      </button>\n\n      <h2 id=\"mf-size-guide-title\" class=\"mf-size-guide__heading\">\n        Guía de tallas\n      </h2>\n\n      <p class=\"mf-size-guide__subheading\">\n        Faja moldeadora Mi Forma\n      </p>\n\n      <div class=\"mf-size-guide__table-wrap\">\n        <table class=\"mf-size-guide__table\">\n          <thead>\n            <tr>\n              <th>Talla</th>\n              <th>Cintura</th>\n              <th>Caderas</th>\n              <th>Talla ES / EU</th>\n            </tr>\n          </thead>\n\n          <tbody>\n            <tr>\n              <td>XS</td>\n              <td>60–64 cm</td>\n              <td>84–90 cm</td>\n              <td>34–36</td>\n            </tr>\n\n            <tr>\n              <td>S</td>\n              <td>65–69 cm</td>\n              <td>90–96 cm</td>\n              <td>38–40</td>\n            </tr>\n\n            <tr>\n              <td>M</td>\n              <td>70–75 cm</td>\n              <td>96–102 cm</td>\n              <td>42–44</td>\n            </tr>\n\n            <tr>\n              <td>L</td>\n              <td>76–82 cm</td>\n              <td>102–108 cm</td>\n              <td>44–46</td>\n            </tr>\n\n            <tr>\n              <td>XL</td>\n              <td>83–90 cm</td>\n              <td>108–114 cm</td>\n              <td>46–48</td>\n            </tr>\n\n            <tr>\n              <td>2XL</td>\n              <td>91–98 cm</td>\n              <td>114–120 cm</td>\n              <td>50–52</td>\n            </tr>\n\n            <tr>\n              <td>3XL</td>\n              <td>99–106 cm</td>\n              <td>120–126 cm</td>\n              <td>54–56</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"mf-size-guide__steps\">\n        <p>\n          <strong>Paso 1:</strong>\n          Ponte de pie y mide tu cintura en el punto más estrecho, por encima del ombligo.\n        </p>\n\n        <p>\n          <strong>Paso 2:</strong>\n          Mide tus caderas en el punto más ancho con los pies juntos.\n        </p>\n\n        <p>\n          <strong>Paso 3:</strong>\n          Compara tus medidas con la tabla para encontrar tu talla ideal.\n        </p>\n      </div>\n\n      <p class=\"mf-size-guide__tip\">\n        Si estás entre dos tallas, elige la talla más grande para disfrutar de una compresión cómoda durante todo el día.\n      </p>\n    </div>\n  </div>\n</div>\n\n<script>\n  (function () {\n    const script = document.currentScript;\n    const wrapper = script.previousElementSibling;\n\n    if (!wrapper) return;\n\n    const button = wrapper.querySelector('.mf-size-guide__button');\n    const overlay = wrapper.querySelector('.mf-size-guide__overlay');\n    const closeButton = wrapper.querySelector('.mf-size-guide__close');\n\n    function openModal() {\n      overlay.classList.add('is-open');\n      overlay.setAttribute('aria-hidden', 'false');\n      document.body.classList.add('mf-size-guide-lock');\n      closeButton.focus();\n    }\n\n    function closeModal() {\n      overlay.classList.remove('is-open');\n      overlay.setAttribute('aria-hidden', 'true');\n      document.body.classList.remove('mf-size-guide-lock');\n      button.focus();\n    }\n\n    button.addEventListener('click', openModal);\n    closeButton.addEventListener('click', closeModal);\n\n    overlay.addEventListener('click', function (event) {\n      if (event.target === overlay) {\n        closeModal();\n      }\n    });\n\n    document.addEventListener('keydown', function (event) {\n      if (event.key === 'Escape' && overlay.classList.contains('is-open')) {\n        closeModal();\n      }\n    });\n  })();\n</script>"
