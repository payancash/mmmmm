            "liquid": "<section class=\"mi-forma-video-section\">\n  <h2 class=\"mi-forma-video-title\">\n    Des milliers de femmes partagent leurs résultats\n  </h2>\n\n  <!-- Ajoute poster=\"URL_IMAGE\" sur chaque <video> : c'est ce que voit la cliente avant le chargement -->\n  <div class=\"mi-forma-video-slider\">\n    <div class=\"mi-forma-video-card\">\n      <video class=\"mi-forma-lazyvideo\" data-src=\"https://cdn.shopify.com/videos/c/o/v/0ee96e1f442e457a946c8af7fb2901db.mp4\" muted loop playsinline preload=\"none\" disablepictureinpicture></video>\n    </div>\n    <div class=\"mi-forma-video-card\">\n      <video class=\"mi-forma-lazyvideo\" data-src=\"https://cdn.shopify.com/videos/c/o/v/01f4fe17241240868260d9cac060753d.mp4\" muted loop playsinline preload=\"none\" disablepictureinpicture></video>\n    </div>\n    <div class=\"mi-forma-video-card\">\n      <video class=\"mi-forma-lazyvideo\" data-src=\"https://cdn.shopify.com/videos/c/o/v/292fe385902442cbb6ecc8f18123802a.mp4\" muted loop playsinline preload=\"none\" disablepictureinpicture></video>\n    </div>\n    <div class=\"mi-forma-video-card\">\n      <video class=\"mi-forma-lazyvideo\" data-src=\"https://cdn.shopify.com/videos/c/o/v/de40f82535f643b7965dfed5f9a667ff.mp4\" muted loop playsinline preload=\"none\" disablepictureinpicture></video>\n    </div>\n    <div class=\"mi-forma-video-card\">\n      <video class=\"mi-forma-lazyvideo\" data-src=\"https://cdn.shopify.com/videos/c/o/v/e85015a4f2cc465dbc03c4badc6114b5.mp4\" muted loop playsinline preload=\"none\" disablepictureinpicture></video>\n    </div>\n    <div class=\"mi-forma-video-card\">\n      <video class=\"mi-forma-lazyvideo\" data-src=\"https://cdn.shopify.com/videos/c/o/v/d5886685852e44d68ea1bfc64f4247da.mp4\" muted loop playsinline preload=\"none\" disablepictureinpicture></video>\n    </div>\n  </div>\n</section>\n\n<style>\n  .mi-forma-video-section {\n    width: 100%;\n    margin: 0;\n    padding: 28px 0 24px;\n    background: #ffffff;\n    overflow: hidden;\n  }\n  .mi-forma-video-title {\n    margin: 0 24px 22px;\n    color: #111111;\n    text-align: center;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 28px;\n    font-weight: 800;\n    line-height: 1.2;\n  }\n  .mi-forma-video-slider {\n    display: flex;\n    gap: 14px;\n    width: 100%;\n    padding: 0 20px 10px;\n    box-sizing: border-box;\n    overflow-x: auto;\n    overflow-y: hidden;\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n  }\n  .mi-forma-video-slider::-webkit-scrollbar {\n    display: none;\n  }\n  .mi-forma-video-card {\n    position: relative;\n    flex: 0 0 29%;\n    min-width: 29%;\n    aspect-ratio: 9 / 16;\n    overflow: hidden;\n    background: #f4f1f2;\n    border-radius: 16px;\n    scroll-snap-align: start;\n    line-height: 0;\n  }\n  .mi-forma-video-card video {\n    display: block;\n    width: 100%;\n    height: 100%;\n    margin: 0;\n    border: 0;\n    object-fit: cover;\n  }\n\n  /* Effet de chargement, retiré dès que la vidéo est prête */\n  .mi-forma-video-card:not(.is-loaded)::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(100deg, #f4f1f2 25%, #eae4e6 45%, #f4f1f2 65%);\n    background-size: 240% 100%;\n    animation: mi-forma-shimmer 1.5s linear infinite;\n  }\n  @keyframes mi-forma-shimmer {\n    from { background-position: 130% 0; }\n    to { background-position: -130% 0; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .mi-forma-video-card:not(.is-loaded)::after {\n      animation: none;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .mi-forma-video-section {\n      padding: 24px 0 20px;\n    }\n    .mi-forma-video-title {\n      margin: 0 28px 20px;\n      font-size: 23px;\n      line-height: 1.25;\n    }\n    .mi-forma-video-slider {\n      gap: 12px;\n      padding-left: 18px;\n      padding-right: 18px;\n    }\n    .mi-forma-video-card {\n      flex-basis: 42%;\n      min-width: 42%;\n      border-radius: 14px;\n    }\n  }\n  @media screen and (max-width: 390px) {\n    .mi-forma-video-title {\n      font-size: 21px;\n    }\n    .mi-forma-video-card {\n      flex-basis: 44%;\n      min-width: 44%;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n    document.querySelectorAll('.mi-forma-video-section').forEach(function (section) {\n      if (section.dataset.lazyInit) return;\n      section.dataset.lazyInit = 'true';\n\n      var slider = section.querySelector('.mi-forma-video-slider');\n      var videos = Array.prototype.slice.call(\n        section.querySelectorAll('.mi-forma-lazyvideo')\n      );\n\n      if (!slider || !videos.length) return;\n\n      function loadVideo(video) {\n        if (video.dataset.loaded) return;\n        video.dataset.loaded = 'true';\n\n        video.addEventListener('loadeddata', function () {\n          var card = video.closest('.mi-forma-video-card');\n          if (card) card.classList.add('is-loaded');\n        }, { once: true });\n\n        video.src = video.dataset.src;\n        video.load();\n      }\n\n      function playVideo(video) {\n        if (reduceMotion) return;\n        video.muted = true;\n        video.play().catch(function () {});\n      }\n\n      // Navigateurs sans IntersectionObserver : comportement classique\n      if (!('IntersectionObserver' in window)) {\n        videos.forEach(function (video) {\n          loadVideo(video);\n          playVideo(video);\n        });\n        return;\n      }\n\n      var sectionVisible = false;\n\n      function sync(video) {\n        if (sectionVisible && video.dataset.inview) {\n          loadVideo(video);\n          playVideo(video);\n        } else if (video.dataset.loaded) {\n          video.pause();\n        }\n      }\n\n      // 1. Quelles cartes sont visibles dans le carrousel (défilement horizontal)\n      var horizontal = new IntersectionObserver(function (entries) {\n        entries.forEach(function (entry) {\n          if (entry.isIntersecting) {\n            entry.target.dataset.inview = 'true';\n          } else {\n            delete entry.target.dataset.inview;\n          }\n          sync(entry.target);\n        });\n      }, { root: slider, rootMargin: '0px 220px', threshold: 0.15 });\n\n      videos.forEach(function (video) {\n        horizontal.observe(video);\n      });\n\n      // 2. La section est-elle à l'écran ? Rien ne se charge avant.\n      var vertical = new IntersectionObserver(function (entries) {\n        entries.forEach(function (entry) {\n          sectionVisible = entry.isIntersecting;\n          videos.forEach(sync);\n        });\n      }, { rootMargin: '250px 0px', threshold: 0 });\n\n      vertical.observe(section);\n    });\n  })();\n</script>"
          }
        },
        "liquid_8UgkBA": {
          "type": "liquid",
          "settings": {
            "liquid": "<section class=\"mi-forma-details\">\n\n  <!-- 1. DÉTAILS DU PRODUIT -->\n  <details class=\"mi-forma-accordion\">\n    <summary>\n      <span>Détails du produit</span>\n      <span class=\"mi-forma-arrow\"></span>\n    </summary>\n\n    <div class=\"mi-forma-content\">\n      <p>\n        <strong>Tissu&nbsp;:</strong> 80&nbsp;% nylon, 20&nbsp;% élasthanne\n      </p>\n\n      <p>\n        <strong>Tailles disponibles&nbsp;:</strong> du XS au 3XL\n      </p>\n\n      <p>\n        <strong>Coloris disponibles&nbsp;:</strong> noir, beige, bleu marine,\n        violet, rose fuchsia, violet foncé, lilas\n      </p>\n\n      <ul>\n        <li>\n          Compression 360° qui soutient le ventre devant, sur les côtés\n          et dans le dos\n        </li>\n        <li>\n          Lisse et redessine la silhouette instantanément, dès que vous la portez\n        </li>\n        <li>\n          Bande croisée qui lisse sans serrer ni glisser\n        </li>\n        <li>\n          Taille haute qui ne s’enroule pas et ne bouge pas\n        </li>\n        <li>\n          Effet gainant invisible sous les vêtements\n        </li>\n        <li>\n          Tissu doux et respirant, à porter toute la journée\n        </li>\n      </ul>\n    </div>\n  </details>\n\n  <!-- 2. TAILLE ET AJUSTEMENT -->\n  <details class=\"mi-forma-accordion\">\n    <summary>\n      <span>Taille et ajustement</span>\n      <span class=\"mi-forma-arrow\"></span>\n    </summary>\n\n    <div class=\"mi-forma-content\">\n      <p>\n        <strong>Un ajustement parfait garanti.</strong>\n        La culotte gainante Mi Forma est conçue avec des zones de compression\n        360° et une ceinture qui ne s’enroule pas, pour un confort maximal\n        tout au long de la journée.\n      </p>\n\n      <p>\n        <strong>Disponible de la taille XS au 3XL.</strong>\n        Consultez le guide des tailles ci-dessous et choisissez votre taille\n        habituelle. Si vous hésitez entre deux tailles, nous vous recommandons\n        de prendre la taille au-dessus pour plus de confort.\n      </p>\n\n      <div class=\"mi-forma-size-image\">\n        <img\n          src=\"https://cdn.shopify.com/s/files/1/0941/3764/7370/files/ChatGPT_Image_4_aout_2026_19_01_11.png?v=1785866642\"\n          alt=\"Guide des tailles de la culotte gainante Mi Forma\"\n          loading=\"lazy\"\n        >\n      </div>\n    </div>\n  </details>\n\n  <!-- 3. ENTRETIEN ET LAVAGE -->\n  <details class=\"mi-forma-accordion\">\n    <summary>\n      <span>Entretien et lavage</span>\n      <span class=\"mi-forma-arrow\"></span>\n    </summary>\n\n    <div class=\"mi-forma-content\">\n      <p>\n        Lavez en cycle délicat à l’eau froide afin de protéger le tissu et de\n        préserver l’effet de compression 360°. Pas de sèche-linge, pas de javel.\n      </p>\n    </div>\n  </details>\n\n  <!-- 4. LIVRAISON ET RETOURS -->\n  <details class=\"mi-forma-accordion\">\n    <summary>\n      <span>Livraison, expédition et retours</span>\n      <span class=\"mi-forma-arrow\"></span>\n    </summary>\n\n    <div class=\"mi-forma-content\">\n      <p>\n        <strong>Délais de livraison.</strong>\n        Les délais de livraison approximatifs sont les suivants&nbsp;:\n      </p>\n\n      <ul>\n        <li>France et Europe&nbsp;: 6 à 8 jours ouvrés</li>\n        <li>\n          Outre-mer et Amérique latine&nbsp;: 7 à 11 jours ouvrés\n        </li>\n        <li>\n          États-Unis et reste du monde&nbsp;: 8 à 12 jours ouvrés\n        </li>\n      </ul>\n\n      <p>\n        <strong>Suivi de commande.</strong>\n        La livraison en France prend environ 6 à 8 jours ouvrés. Vous pouvez\n        suivre votre commande directement depuis la rubrique Suivre ma commande.\n      </p>\n\n      <p>\n        <strong>Retours et remboursements.</strong>\n        Si vous n’êtes pas satisfaite de votre achat, vous pouvez le retourner\n        dans un délai de 30 jours après réception pour obtenir un remboursement\n        intégral.\n      </p>\n    </div>\n  </details>\n\n  <!-- 5. GARANTIE -->\n  <details class=\"mi-forma-accordion\">\n    <summary>\n      <span>Garantie ajustement parfait 30 jours</span>\n      <span class=\"mi-forma-arrow\"></span>\n    </summary>\n\n    <div class=\"mi-forma-content\">\n      <p>\n        Essayez votre culotte Mi Forma sans risque pendant 30 jours. Si ce n’est\n        pas la culotte gainante la plus confortable que vous ayez portée,\n        renvoyez-la et nous vous remboursons intégralement, sans poser de\n        questions.\n      </p>\n\n      <p>\n        Nous avons confiance en notre produit et nous voulons que vous soyez\n        100&nbsp;% satisfaite de votre achat.\n      </p>\n    </div>\n  </details>\n\n</section>\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');\n\n  .mi-forma-details {\n    width: 100%;\n    margin: 0 auto;\n    padding: 0 20px;\n    box-sizing: border-box;\n    background: #ffffff;\n    color: #292929;\n    font-family: 'Poppins', Arial, sans-serif;\n  }\n\n  .mi-forma-accordion {\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    border: 0;\n    border-bottom: 1px solid #e6e6e6;\n  }\n\n  .mi-forma-accordion summary {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 15px;\n    padding: 22px 0;\n    cursor: pointer;\n    list-style: none;\n    color: #1d1d1d;\n    font-family: 'Playfair Display', Georgia, serif;\n    font-size: 18px;\n    font-weight: 700;\n    line-height: 1.3;\n  }\n\n  .mi-forma-accordion summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .mi-forma-arrow {\n    width: 8px;\n    height: 8px;\n    flex-shrink: 0;\n    border-right: 1.5px solid #111111;\n    border-bottom: 1.5px solid #111111;\n    transform: rotate(45deg);\n    transition: transform 0.25s ease;\n  }\n\n  .mi-forma-accordion[open] .mi-forma-arrow {\n    transform: rotate(225deg);\n  }\n\n  .mi-forma-content {\n    padding: 0 0 24px;\n    color: #353535;\n    font-size: 16px;\n    font-weight: 400;\n    line-height: 1.55;\n    letter-spacing: 0.02em;\n  }\n\n  .mi-forma-content p {\n    margin: 0 0 22px;\n  }\n\n  .mi-forma-content p:last-child {\n    margin-bottom: 0;\n  }\n\n  .mi-forma-content strong {\n    color: #2a2a2a;\n    font-weight: 700;\n  }\n\n  .mi-forma-content ul {\n    margin: 0 0 4px;\n    padding-left: 25px;\n  }\n\n  .mi-forma-content li {\n    margin-bottom: 4px;\n    padding-left: 3px;\n  }\n\n  .mi-forma-size-image {\n    width: 100%;\n    margin-top: 44px;\n    overflow: hidden;\n    line-height: 0;\n  }\n\n  .mi-forma-size-image img {\n    display: block;\n    width: 100%;\n    height: auto;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  @media screen and (max-width: 749px) {\n    .mi-forma-details {\n      padding: 0 19px;\n    }\n\n    .mi-forma-accordion summary {\n      padding: 20px 0;\n      font-size: 17px;\n    }\n\n    .mi-forma-content {\n      padding-bottom: 22px;\n      font-size: 15px;\n      line-height: 1.55;\n    }\n\n    .mi-forma-content p {\n      margin-bottom: 20px;\n    }\n\n    .mi-forma-size-image {\n      margin-top: 34px;\n    }\n  }\n</style>"
