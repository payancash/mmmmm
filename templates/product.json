15px;\n    height: 15px;\n    background: #2A9D8F;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n\n  .review-check svg {\n    width: 8px;\n    height: 8px;\n  }\n\n  .review-verified-text {\n    font-size: 11px;\n    color: #2A9D8F;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n</style>\n\n<div class=\"social-section\">\n\n  <h2 class=\"social-title\">Adorée par plus de 30 000 femmes</h2>\n\n  <div class=\"social-grid\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0941/3764/7370/files/Avant_11.jpg?v=1785880305\"\n      alt=\"\"\n      loading=\"lazy\"\n    >\n\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0941/3764/7370/files/Avant_10.jpg?v=1785880305\"\n      alt=\"\"\n      loading=\"lazy\"\n    >\n\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0941/3764/7370/files/Avant_9.jpg?v=1785880305\"\n      alt=\"\"\n      loading=\"lazy\"\n    >\n\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0941/3764/7370/files/hf_20260625_113642_0581a649-b31b-4538-a746-f35b6c05c78c.jpg?v=1785880306\"\n      alt=\"\"\n      loading=\"lazy\"\n    >\n\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0941/3764/7370/files/hf_20260625_114204_4c60e29d-cd04-4025-9543-36fdc340bfdf.jpg?v=1785880307\"\n      alt=\"\"\n      loading=\"lazy\"\n    >\n\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0941/3764/7370/files/hf_20260625_120909_c3e45dde-440c-4306-b4a0-de3aec1a0110.jpg?v=1785880307\"\n      alt=\"\"\n      loading=\"lazy\"\n    >\n  </div>\n\n  <div class=\"reviews-wrap\">\n    <div class=\"reviews-track\">\n\n      <!-- AVIS 1 -->\n      <div class=\"review-card\">\n        <div class=\"review-stars\">\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n        </div>\n\n        <div class=\"review-text\">\n          <strong>2 semaines et mon ventre a déjà changé.</strong>\n          J'ai accouché il y a 4 mois et j'avais ce ventre mou qui ne partait pas.\n          La Belayan, je l'enfile comme une culotte normale et je l'oublie toute\n          la journée. Au bout de 2 semaines, mon mari m'a dit :\n          « T'as le ventre plus plat, non ? » Je regrette de ne pas l'avoir eue\n          dès la maternité.\n        </div>\n\n        <div class=\"review-footer\">\n          <span class=\"review-name\">Camille B., 31 ans</span>\n\n          <div class=\"review-verified\">\n            <div class=\"review-check\">\n              <svg viewBox=\"0 0 10 10\" fill=\"none\">\n                <path d=\"M2 5l2.5 2.5L8 3\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n\n            <span class=\"review-verified-text\">Acheteuse vérifiée</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- AVIS 2 -->\n      <div class=\"review-card\">\n        <div class=\"review-stars\">\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n        </div>\n\n        <div class=\"review-text\">\n          <strong>Invisible sous ma robe, même moulante.</strong>\n          J'avais peur que ça se voie ou que ça roule. Pas du tout. Je la porte\n          tous les jours sous mes robes d'été et personne ne sait que j'ai une\n          gaine. C'est la première qui ne me gêne pas du tout, même assise toute\n          la journée au bureau.\n        </div>\n\n        <div class=\"review-footer\">\n          <span class=\"review-name\">Sarah M., 28 ans</span>\n\n          <div class=\"review-verified\">\n            <div class=\"review-check\">\n              <svg viewBox=\"0 0 10 10\" fill=\"none\">\n                <path d=\"M2 5l2.5 2.5L8 3\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n\n            <span class=\"review-verified-text\">Acheteuse vérifiée</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- AVIS 3 -->\n      <div class=\"review-card\">\n        <div class=\"review-stars\">\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n        </div>\n\n        <div class=\"review-text\">\n          <strong>Post-césarienne, c'est exactement ce qu'il me fallait.</strong>\n          Ma sage-femme m'avait conseillé d'attendre 6 semaines. Dès que j'ai pu\n          la mettre, j'ai senti un maintien que je n'avais avec aucune ceinture.\n          Ça ne touche pas la cicatrice et ça tient tout le ventre, les côtés et\n          le dos. Un vrai soulagement.\n        </div>\n\n        <div class=\"review-footer\">\n          <span class=\"review-name\">Inès D., 34 ans</span>\n\n          <div class=\"review-verified\">\n            <div class=\"review-check\">\n              <svg viewBox=\"0 0 10 10\" fill=\"none\">\n                <path d=\"M2 5l2.5 2.5L8 3\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n\n            <span class=\"review-verified-text\">Acheteuse vérifiée</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- AVIS 4 -->\n      <div class=\"review-card\">\n        <div class=\"review-stars\">\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n        </div>\n\n        <div class=\"review-text\">\n          <strong>Mon dernier accouchement date de 3 ans. Ça marche quand même.</strong>\n          Je pensais que c'était trop tard pour moi. Après 3 ans, je m'étais\n          résignée à garder ce petit ventre. En 3 semaines de Belayan, ma taille\n          est redessinée. Je rentre dans des jeans que j'avais rangés. Mon seul\n          regret, c'est de ne pas avoir essayé avant.\n        </div>\n\n        <div class=\"review-footer\">\n          <span class=\"review-name\">Laura T., 37 ans</span>\n\n          <div class=\"review-verified\">\n            <div class=\"review-check\">\n              <svg viewBox=\"0 0 10 10\" fill=\"none\">\n                <path d=\"M2 5l2.5 2.5L8 3\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n\n            <span class=\"review-verified-text\">Acheteuse vérifiée</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- AVIS 5 -->\n      <div class=\"review-card\">\n        <div class=\"review-stars\">\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n        </div>\n\n        <div class=\"review-text\">\n          <strong>Mieux que toutes les ceintures que j'ai achetées.</strong>\n          J'en ai essayé 3 avant : des ceintures à scratch et une gaine tube.\n          Tout glissait, roulait et me coupait la circulation. La Belayan, c'est\n          une vraie culotte, elle reste en place toute la journée. La compression\n          est douce mais ferme. Je l'allaite avec, aucun souci.\n        </div>\n\n        <div class=\"review-footer\">\n          <span class=\"review-name\">Anaïs R., 29 ans</span>\n\n          <div class=\"review-verified\">\n            <div class=\"review-check\">\n              <svg viewBox=\"0 0 10 10\" fill=\"none\">\n                <path d=\"M2 5l2.5 2.5L8 3\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n\n            <span class=\"review-verified-text\">Acheteuse vérifiée</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- AVIS 6 -->\n      <div class=\"review-card\">\n        <div class=\"review-stars\">\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n        </div>\n\n        <div class=\"review-text\">\n          <strong>J'ai commandé pour ma sœur aussi.</strong>\n          Ma fille a 5 mois. Dès la première journée, j'ai senti la différence :\n          le ventre maintenu, le dos soulagé, une vraie sensation de « tout est\n          remis en place ». Après 2 semaines, j'ai commandé la deuxième pour ma\n          sœur qui accouche en septembre.\n        </div>\n\n        <div class=\"review-footer\">\n          <span class=\"review-name\">Mélanie P., 33 ans</span>\n\n          <div class=\"review-verified\">\n            <div class=\"review-check\">\n              <svg viewBox=\"0 0 10 10\" fill=\"none\">\n                <path d=\"M2 5l2.5 2.5L8 3\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n\n            <span class=\"review-verified-text\">Acheteuse vérifiée</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- AVIS 7 -->\n      <div class=\"review-card\">\n        <div class=\"review-stars\">\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n        </div>\n\n        <div class=\"review-text\">\n          <strong>Le tissu est vraiment doux, pas de plastique.</strong>\n          Ce qui m'a surprise, c'est la qualité du tissu. Respirant, doux, pas\n          une gaine bas de gamme qui fait transpirer. Je la porte même la nuit\n          et je ne la sens plus. Mon ventre est nettement plus plat le matin.\n          Ça m'a redonné confiance.\n        </div>\n\n        <div class=\"review-footer\">\n          <span class=\"review-name\">Charlotte V., 26 ans</span>\n\n          <div class=\"review-verified\">\n            <div class=\"review-check\">\n              <svg viewBox=\"0 0 10 10\" fill=\"none\">\n                <path d=\"M2 5l2.5 2.5L8 3\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n\n            <span class=\"review-verified-text\">Acheteuse vérifiée</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- AVIS 8 -->\n      <div class=\"review-card\">\n        <div class=\"review-stars\">\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n          <svg viewBox=\"0 0 20 20\" fill=\"#F5A623\"><path d=\"M10 1l2.4 7H19l-5.7 4.1 2.2 6.9L10 15l-5.5 4 2.2-6.9L1 9h6.6z\"/></svg>\n        </div>\n\n        <div class=\"review-text\">\n          <strong>Effet immédiat sous la robe de mariage de ma copine.</strong>\n          J'avais un mariage 6 semaines après mon accouchement. J'ai mis la\n          Belayan sous ma robe et j'avais un ventre plat toute la soirée.\n          Personne n'aurait deviné que j'avais accouché. Depuis, je la porte\n          tous les jours.\n        </div>\n\n        <div class=\"review-footer\">\n          <span class=\"review-name\">Justine L., 30 ans</span>\n\n          <div class=\"review-verified\">\n            <div class=\"review-check\">\n              <svg viewBox=\"0 0 10 10\" fill=\"none\">\n                <path d=\"M2 5l2.5 2.5L8 3\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n\n            <span class=\"review-verified-text\">Acheteuse vérifiée</span>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n</div>",
