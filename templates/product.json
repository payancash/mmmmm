            "liquid": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800&display=swap');\n\n  .mf-sg {\n    --mf-accent: #b3437a;\n    --mf-accent-deep: #8d2f5f;\n    --mf-blush: #fbeff5;\n    --mf-blush-strong: #f6e0ec;\n    --mf-tip: #fdf6f9;\n    --mf-border: #f2e2ea;\n    --mf-ink: #3b2a33;\n    --mf-ink-soft: #7a6672;\n\n    width: 100%;\n    font-family: 'Nunito Sans', 'Helvetica Neue', Arial, sans-serif;\n    box-sizing: border-box;\n  }\n\n  .mf-sg *,\n  .mf-sg *::before,\n  .mf-sg *::after {\n    box-sizing: border-box;\n  }\n\n  /* ---------- Bouton d'ouverture ---------- */\n\n  .mf-sg__button-wrap {\n    display: flex;\n    justify-content: center;\n    width: 100%;\n  }\n\n  .mf-sg__button {\n    appearance: none;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    border: 1px solid var(--mf-accent);\n    background: var(--mf-accent);\n    color: #ffffff;\n    padding: 14px 30px;\n    border-radius: 999px;\n    font-family: inherit;\n    font-size: 15px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 0.01em;\n    cursor: pointer;\n    box-shadow: 0 8px 22px rgba(179, 67, 122, 0.22);\n    transition: transform 0.2s ease, background 0.2s ease;\n  }\n\n  .mf-sg__button:hover {\n    background: var(--mf-accent-deep);\n    border-color: var(--mf-accent-deep);\n    transform: translateY(-1px);\n  }\n\n  .mf-sg__button:focus-visible,\n  .mf-sg__close:focus-visible {\n    outline: 2px solid var(--mf-accent);\n    outline-offset: 2px;\n  }\n\n  /* ---------- Fenêtre modale ---------- */\n\n  .mf-sg__overlay {\n    position: fixed;\n    inset: 0;\n    z-index: 999999;\n    display: none;\n    align-items: center;\n    justify-content: center;\n    padding: 20px;\n    background: rgba(59, 42, 51, 0.5);\n  }\n\n  .mf-sg__overlay.is-open {\n    display: flex;\n  }\n\n  .mf-sg__modal {\n    position: relative;\n    width: 100%;\n    max-width: 560px;\n    max-height: 88vh;\n    overflow-y: auto;\n    background: #ffffff;\n    border-radius: 20px;\n    box-shadow: 0 24px 70px rgba(141, 47, 95, 0.22);\n  }\n\n  .mf-sg__header {\n    padding: 34px 60px 30px;\n    background: var(--mf-blush);\n    border-radius: 20px 20px 0 0;\n    text-align: center;\n  }\n\n  .mf-sg__close {\n    position: absolute;\n    top: 18px;\n    right: 18px;\n    width: 34px;\n    height: 34px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0;\n    border: 0;\n    border-radius: 999px;\n    background: transparent;\n    color: var(--mf-ink);\n    cursor: pointer;\n    transition: background 0.2s ease;\n  }\n\n  .mf-sg__close:hover {\n    background: var(--mf-blush-strong);\n  }\n\n  .mf-sg__close svg {\n    width: 20px;\n    height: 20px;\n  }\n\n  .mf-sg__heading {\n    margin: 0;\n    color: var(--mf-ink);\n    font-size: 26px;\n    font-weight: 800;\n    line-height: 1.2;\n  }\n\n  .mf-sg__subheading {\n    margin: 10px 0 0;\n    color: var(--mf-ink-soft);\n    font-size: 15px;\n    font-weight: 400;\n    line-height: 1.4;\n  }\n\n  .mf-sg__body {\n    padding: 24px 22px 26px;\n  }\n\n  /* ---------- Tableau ---------- */\n\n  .mf-sg__table-wrap {\n    width: 100%;\n    overflow-x: auto;\n  }\n\n  .mf-sg__table {\n    width: 100%;\n    min-width: 380px;\n    border-collapse: collapse;\n    color: var(--mf-ink);\n    font-size: 15px;\n  }\n\n  .mf-sg__table th {\n    padding: 16px 14px;\n    background: var(--mf-blush-strong);\n    color: var(--mf-accent-deep);\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .mf-sg__table thead th:first-child {\n    border-radius: 10px 0 0 10px;\n    text-align: left;\n  }\n\n  .mf-sg__table thead th:last-child {\n    border-radius: 0 10px 10px 0;\n  }\n\n  .mf-sg__table td {\n    padding: 22px 14px;\n    border-bottom: 1px solid var(--mf-border);\n    text-align: center;\n    font-weight: 400;\n  }\n\n  .mf-sg__table td:first-child {\n    text-align: left;\n    color: var(--mf-accent);\n    font-size: 17px;\n    font-weight: 800;\n  }\n\n  .mf-sg__table tbody tr:last-child td {\n    border-bottom: 0;\n  }\n\n  /* ---------- Conseil ---------- */\n\n  .mf-sg__tip {\n    display: flex;\n    gap: 12px;\n    margin-top: 20px;\n    padding: 18px 20px;\n    background: var(--mf-tip);\n    border: 1px solid var(--mf-border);\n    border-radius: 14px;\n  }\n\n  .mf-sg__tip-icon {\n    flex: 0 0 auto;\n    font-size: 17px;\n    line-height: 1.5;\n  }\n\n  .mf-sg__tip p {\n    margin: 0;\n    color: var(--mf-ink);\n    font-size: 15px;\n    line-height: 1.5;\n  }\n\n  .mf-sg__tip strong {\n    color: var(--mf-accent-deep);\n    font-weight: 800;\n  }\n\n  body.mf-sg-lock {\n    overflow: hidden;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .mf-sg__button {\n      transition: none;\n    }\n\n    .mf-sg__button:hover {\n      transform: none;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .mf-sg__overlay {\n      padding: 12px;\n    }\n\n    .mf-sg__modal {\n      max-height: 90vh;\n      border-radius: 16px;\n    }\n\n    .mf-sg__header {\n      padding: 28px 46px 24px;\n      border-radius: 16px 16px 0 0;\n    }\n\n    .mf-sg__heading {\n      font-size: 22px;\n    }\n\n    .mf-sg__subheading {\n      font-size: 14px;\n    }\n\n    .mf-sg__body {\n      padding: 20px 14px 22px;\n    }\n\n    .mf-sg__table {\n      min-width: 320px;\n      font-size: 14px;\n    }\n\n    .mf-sg__table th,\n    .mf-sg__table td {\n      padding: 15px 8px;\n    }\n\n    .mf-sg__table td:first-child {\n      font-size: 15px;\n    }\n\n    .mf-sg__tip p {\n      font-size: 14px;\n    }\n  }\n</style>\n\n<div class=\"mf-sg\">\n  <div class=\"mf-sg__button-wrap\">\n    <button\n      type=\"button\"\n      class=\"mf-sg__button\"\n      aria-haspopup=\"dialog\"\n      aria-controls=\"mf-sg-modal\"\n    >\n      Guide des tailles ›\n    </button>\n  </div>\n\n  <div class=\"mf-sg__overlay\" aria-hidden=\"true\">\n    <div\n      id=\"mf-sg-modal\"\n      class=\"mf-sg__modal\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"mf-sg-title\"\n    >\n      <button\n        type=\"button\"\n        class=\"mf-sg__close\"\n        aria-label=\"Fermer le guide des tailles\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\">\n          <path d=\"M5 5l14 14M19 5L5 19\" />\n        </svg>\n      </button>\n\n      <div class=\"mf-sg__header\">\n        <h2 id=\"mf-sg-title\" class=\"mf-sg__heading\">Guide des Tailles</h2>\n        <p class=\"mf-sg__subheading\">Culotte Post-Partum Compression 360°</p>\n      </div>\n\n      <div class=\"mf-sg__body\">\n        <div class=\"mf-sg__table-wrap\">\n          <table class=\"mf-sg__table\">\n            <thead>\n              <tr>\n                <th scope=\"col\">Belayan</th>\n                <th scope=\"col\">Tour de taille</th>\n                <th scope=\"col\">Taille FR</th>\n              </tr>\n            </thead>\n\n            <tbody>\n              <tr>\n                <td>S</td>\n                <td>62 – 68 cm</td>\n                <td>34 – 36</td>\n              </tr>\n\n              <tr>\n                <td>M</td>\n                <td>68 – 76 cm</td>\n                <td>38 – 40</td>\n              </tr>\n\n              <tr>\n                <td>L</td>\n                <td>76 – 82 cm</td>\n                <td>40 – 42</td>\n              </tr>\n\n              <tr>\n                <td>XL</td>\n                <td>82 – 90 cm</td>\n                <td>44 – 46</td>\n              </tr>\n\n              <tr>\n                <td>2XL</td>\n                <td>88 – 100 cm</td>\n                <td>48 – 50</td>\n              </tr>\n\n              <tr>\n                <td>3XL</td>\n                <td>92 – 112 cm</td>\n                <td>50 – 52+</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n\n        <div class=\"mf-sg__tip\">\n          <span class=\"mf-sg__tip-icon\" aria-hidden=\"true\">💡</span>\n          <p>\n            Entre deux tailles ? Prenez la plus petite pour un\n            <strong>maintien optimal</strong>. Notre tissu mesh épouse votre\n            corps en douceur.\n          </p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n  (function () {\n    var script = document.currentScript;\n    var wrapper = script.previousElementSibling;\n\n    if (!wrapper) return;\n\n    var button = wrapper.querySelector('.mf-sg__button');\n    var overlay = wrapper.querySelector('.mf-sg__overlay');\n    var closeButton = wrapper.querySelector('.mf-sg__close');\n\n    function openModal() {\n      overlay.classList.add('is-open');\n      overlay.setAttribute('aria-hidden', 'false');\n      document.body.classList.add('mf-sg-lock');\n      closeButton.focus();\n    }\n\n    function closeModal() {\n      overlay.classList.remove('is-open');\n      overlay.setAttribute('aria-hidden', 'true');\n      document.body.classList.remove('mf-sg-lock');\n      button.focus();\n    }\n\n    button.addEventListener('click', openModal);\n    closeButton.addEventListener('click', closeModal);\n\n    overlay.addEventListener('click', function (event) {\n      if (event.target === overlay) {\n        closeModal();\n      }\n    });\n\n    document.addEventListener('keydown', function (event) {\n      if (event.key === 'Escape' && overlay.classList.contains('is-open')) {\n        closeModal();\n      }\n    });\n  })();\n</script>"
