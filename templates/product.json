rflow-y: auto;\n    background: #ffffff;\n    border-radius: 20px;\n    box-shadow: 0 24px 70px rgba(141, 47, 95, 0.22);\n  }\n\n  .mf-sg__header {\n    padding: 34px 60px 30px;\n    background: var(--mf-blush);\n    border-radius: 20px 20px 0 0;\n    text-align: center;\n  }\n\n  .mf-sg__close {\n    position: absolute;\n    top: 18px;\n    right: 18px;\n    width: 34px;\n    height: 34px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0;\n    border: 0;\n    border-radius: 999px;\n    background: transparent;\n    color: var(--mf-ink);\n    cursor: pointer;\n    transition: background 0.2s ease;\n  }\n\n  .mf-sg__close:hover {\n    background: var(--mf-blush-strong);\n  }\n\n  .mf-sg__close svg {\n    width: 20px;\n    height: 20px;\n  }\n\n  .mf-sg__heading {\n    margin: 0;\n    color: var(--mf-ink);\n    font-size: 26px;\n    font-weight: 800;\n    line-height: 1.2;\n  }\n\n  .mf-sg__subheading {\n    margin: 10px 0 0;\n    color: var(--mf-ink-soft);\n    font-size: 15px;\n    font-weight: 400;\n    line-height: 1.4;\n  }\n\n  .mf-sg__body {\n    padding: 24px 22px 26px;\n  }\n\n  /* ---------- Tableau ---------- */\n\n  .mf-sg__table-wrap {\n    width: 100%;\n    overflow-x: auto;\n  }\n\n  .mf-sg__table {\n    width: 100%;\n    min-width: 380px;\n    border-collapse: collapse;\n    color: var(--mf-ink);\n    font-size: 15px;\n  }\n\n  .mf-sg__table th {\n    padding: 16px 14px;\n    background: var(--mf-blush-strong);\n    color: var(--mf-accent-deep);\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .mf-sg__table thead th:first-child {\n    border-radius: 10px 0 0 10px;\n    text-align: left;\n  }\n\n  .mf-sg__table thead th:last-child {\n    border-radius: 0 10px 10px 0;\n  }\n\n  .mf-sg__table td {\n    padding: 22px 14px;\n    border-bottom: 1px solid var(--mf-border);\n    text-align: center;\n    font-weight: 400;\n  }\